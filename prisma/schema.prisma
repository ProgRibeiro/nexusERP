// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  // A URL de conexão PostgreSQL é fornecida via prisma.config.ts e DATABASE_URL.
  provider = "postgresql"
}

// 1. Controle de Acesso
model User {
  id                  String                      @id @default(uuid())
  name                String
  email               String                      @unique
  password            String
  salt                String? // Salt individual (PBKDF2). Nulo apenas em contas migradas do esquema antigo até o 1º login.
  roleId              String?
  role                Role?                       @relation(fields: [roleId], references: [id])
  permissions         String                      @default("[]") // JSON string of permission codes
  active              Boolean                     @default(true)
  blockedAt           DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  sessionVersion      Int                         @default(1)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  leads               Lead[]                      @relation("LeadOwner")
  activities          CrmActivity[]
  statusHistory       ServiceOrderStatusHistory[]
  serviceOrdersAsTech ServiceOrderTechnician[]
  visitAssignments    VisitTechnician[]
  visitStatusChanges  VisitStatusHistory[]
  timeEntries         TimeEntry[]
  locationEvents      LocationEvent[]
  evidences           Evidence[]
  measurementReadings MeasurementReading[]
  formSubmissions     FormSubmission[]
  auditLogs           AuditLog[]
  importBatches       ImportBatch[]
  emailIntegrations   EmailIntegration[]          @relation("EmailIntegrationConnector")
  proposalEmails      ProposalEmail[]             @relation("ProposalEmailSender")
  marketingPosts      MarketingPost[]
  errorReports        ErrorReport[]
  tenantAccesses      UserTenantAccess[]
  userRoles           UserRole[]
  loginHistory        LoginHistory[]
  passwordResetTokens PasswordResetToken[]
}

model Tenant {
  id                  String               @id @db.Uuid
  name                String
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  userAccesses        UserTenantAccess[]
  userRoles           UserRole[]
  rolePermissions     RolePermission[]
  loginHistory        LoginHistory[]
  passwordResetTokens PasswordResetToken[]
}

model UserTenantAccess {
  userId    String
  tenantId  String   @db.Uuid
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([userId, tenantId])
  @@index([tenantId])
  @@index([userId, active])
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique // Administrador, Gestor, Comercial, Operacional, Técnico, Faturamento, Financeiro, Estoque
  description     String?
  users           User[]
  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique // e.g. "crm.read", "finance.write"
  name            String
  description     String?
  rolePermissions RolePermission[]
}

model UserRole {
  userId    String
  roleId    String
  tenantId  String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([userId, roleId, tenantId])
  @@index([tenantId])
}

model RolePermission {
  roleId       String
  permissionId String
  tenantId     String     @db.Uuid
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId, tenantId])
  @@index([tenantId])
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String?
  tenantId  String   @db.Uuid
  email     String
  success   Boolean
  reason    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  tenantId    String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
}

// 2. Cadastro de Clientes
model Client {
  id                    String               @id @default(uuid())
  name                  String
  socialName            String? // Razão Social
  fancyName             String? // Nome Fantasia
  cpfCnpj               String?              @unique
  stateRegistration     String? // Inscrição Estadual
  municipalRegistration String? // Inscrição Municipal
  email                 String
  phone                 String
  whatsapp              String?
  segment               String? // e.g. Climatização, Eletricista, Refrigeração
  origin                String? // Como chegou: Google, Indicação, etc.
  status                String               @default("ATIVO") // ATIVO, INATIVO
  defaultPaymentTerms   String? // e.g. "HERING_60", "LIQUIDO_30", "LIQUIDO_21"
  billingGroup          String? // e.g. "Hering", "Grupo Soma", "Azzas 2154", "Cidade Maravilhosa"
  notes                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  contacts              ClientContact[]
  addresses             ClientAddress[]
  equipments            ClientEquipment[]
  quotes                Quote[]
  serviceOrders         ServiceOrder[]
  invoices              Invoice[]
  nfseRecords           NfseRecord[]
  accountsReceivable    AccountsReceivable[]
  contracts             Contract[]
  storeProjects         ClientStoreProject[]
}

model ClientContact {
  id            String         @id @default(uuid())
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name          String
  role          String? // Cargo
  email         String
  phone         String
  whatsapp      String?
  isFinancial   Boolean        @default(false)
  isTechnical   Boolean        @default(false)
  isApproval    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  quotes        Quote[]
  serviceOrders ServiceOrder[]
  contracts     Contract[]
}

model ClientAddress {
  id                  String               @id @default(uuid())
  clientId            String
  client              Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label               String // Principal, Cobrança, Execução, etc.
  street              String
  number              String
  complement          String?
  neighborhood        String
  city                String
  state               String
  cep                 String
  reference           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  quotes              Quote[]
  serviceOrders       ServiceOrder[]
  clientStoreProjects ClientStoreProject[]
  contracts           Contract[]
}

model ClientEquipment {
  id                  String               @id @default(uuid())
  clientId            String
  client              Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type                String // Ar Condicionado, Painel Elétrico, etc.
  brand               String
  model               String
  serialNumber        String
  capacity            String? // e.g. 12000 BTU, 220V
  tag                 String? // Tag identificador interno
  location            String? // Onde está instalado
  installDate         DateTime?
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  serviceOrderLinks   ServiceOrderAsset[]
  evidences           Evidence[]
  measurementReadings MeasurementReading[]
}

// Projetos físicos das unidades atendidas. A planta é armazenada como uma
// representação visual e cada ativo usa coordenadas percentuais, permanecendo
// responsivo em computadores e tablets.
model ClientStoreProject {
  id                String         @id @default(uuid())
  clientId          String
  client            Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  addressId         String?
  address           ClientAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  contractId        String?
  contract          Contract?      @relation(fields: [contractId], references: [id], onDelete: SetNull)
  name              String
  description       String?
  floorPlanData     String?
  floorPlanFileName String?
  floorPlanMimeType String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  assets            StoreAsset[]
  serviceOrders     ServiceOrder[]

  @@index([clientId, updatedAt])
  @@index([contractId])
}

// Patrimônio genérico por projeto: climatização, iluminação, elétrica,
// refrigeração, segurança e qualquer outro item mapeável na planta.
model StoreAsset {
  id                  String               @id @default(uuid())
  projectId           String
  project             ClientStoreProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category            String
  assetType           String?
  name                String
  brand               String?
  model               String?
  manufacturerCode    String?
  serialNumber        String?
  tag                 String?
  quantity            Int                  @default(1)
  unit                String               @default("UN")
  criticality         String               @default("NORMAL")
  status              String               @default("ATIVO")
  location            String?
  specificationsJson  String               @default("{}")
  notes               String?
  positionX           Float                @default(50)
  positionY           Float                @default(50)
  parentAssetId       String?
  parentAsset         StoreAsset?          @relation("StoreAssetHierarchy", fields: [parentAssetId], references: [id], onDelete: Cascade)
  components          StoreAsset[]         @relation("StoreAssetHierarchy")
  photos              StoreAssetPhoto[]
  serviceOrders       ServiceOrder[]
  serviceOrderLinks   ServiceOrderAsset[]
  evidences           Evidence[]
  measurementReadings MeasurementReading[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([projectId, category])
  @@index([projectId, assetType])
  @@index([parentAssetId])
}

model StoreAssetPhoto {
  id        String     @id @default(uuid())
  assetId   String
  asset     StoreAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  dataUrl   String
  fileName  String?
  mimeType  String?
  caption   String?
  isPrimary Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([assetId, createdAt])
}

// 3. CRM & Funil Comercial
model Lead {
  id              String        @id @default(uuid())
  name            String
  email           String?
  phone           String
  company         String?
  status          String        @default("NOVO") // NOVO, EM_ANDAMENTO, CONVERTIDO, PERDIDO
  pipelineStageId String?
  pipelineStage   CrmStage?     @relation(fields: [pipelineStageId], references: [id])
  value           Float         @default(0.0)
  closePrediction DateTime?
  source          String? // Google, Site, etc.
  ownerId         String?
  owner           User?         @relation("LeadOwner", fields: [ownerId], references: [id])
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  activities      CrmActivity[]
}

model CrmPipeline {
  id          String     @id @default(uuid())
  name        String
  description String?
  stages      CrmStage[]
}

model CrmStage {
  id         String      @id @default(uuid())
  pipelineId String
  pipeline   CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String // Novo lead, Contato realizado, Diagnóstico feito, Visita agendada, etc.
  order      Int         @default(0)
  leads      Lead[]
}

model CrmActivity {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String // LIGACAO, WHATSAPP, REUNIAO, VISITA, NOTA
  description String
  date        DateTime
  done        Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 4. Orçamentos (Quotes)
model Quote {
  id                  String               @id @default(uuid())
  code                String               @unique // Q-2026-0001
  storeName           String? // Loja, unidade ou ponto de atendimento da proposta
  clientId            String
  client              Client               @relation(fields: [clientId], references: [id])
  addressId           String?
  address             ClientAddress?       @relation(fields: [addressId], references: [id])
  contactId           String?
  contact             ClientContact?       @relation(fields: [contactId], references: [id])
  proposalType        String               @default("AVULSA") // AVULSA, PREVENTIVA
  procurementNumber   String?              // Número do processo/edital da licitação
  contractingAgency   String?              // Órgão/entidade contratante
  biddingNumber       String?              // Modalidade e número (ex.: CP 04/2026)
  referenceBase       String?              // SINAPI, SICRO, SEINFRA ou outra base
  referenceMonth      String?              // Mês/ano da referência de preços
  publicBudgetSource  String?              // Fonte/orçamento público
  deliveryTerm        String?              // Prazo de entrega/execução da licitação
  preventivePlanJson  String? // Plano estruturado, escopo, equipamentos e frequência da preventiva
  status              String               @default("RASCUNHO") // RASCUNHO, ENVIADO, NEGOCIACAO, APROVADO, REPROVADO, EXPIRADO, CANCELADO, CONVERTIDO
  version             Int                  @default(1)
  validUntil          DateTime
  warrantyDays        Int                  @default(90)
  executionTerm       String? // Prazo de execução (ex: "5 dias úteis")
  paymentTerms        String? // Condições de pagamento (ex: "Pix 50% + 50% após conclusão")
  subtotal            Decimal              @default(0.0) @db.Decimal(10, 2)
  discount            Decimal              @default(0.0) @db.Decimal(10, 2)
  tax                 Decimal              @default(0.0) @db.Decimal(10, 2)
  total               Decimal              @default(0.0) @db.Decimal(10, 2)
  finalValueOverride  Decimal?             @db.Decimal(10, 2) // Valor final comercial definido manualmente
  costEstimate        Decimal              @default(0.0) @db.Decimal(10, 2)
  estimatedMargin     Decimal              @default(0.0) @db.Decimal(10, 2) // Lucro/Margem estimada
  overheadPercentage  Decimal              @default(0.0) @db.Decimal(7, 2)
  riskPercentage      Decimal              @default(0.0) @db.Decimal(7, 2)
  financialPercentage Decimal              @default(0.0) @db.Decimal(7, 2)
  profitPercentage    Decimal              @default(0.0) @db.Decimal(7, 2)
  taxPercentage       Decimal              @default(0.0) @db.Decimal(7, 2)
  bdiPercentage       Decimal              @default(0.0) @db.Decimal(7, 2)
  notes               String?
  approvedAt          DateTime?
  approvedBy          String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  items               QuoteItem[]
  versions            QuoteVersion[]
  approvals           QuoteApproval[]
  serviceOrders       ServiceOrder[]
  accountsReceivable  AccountsReceivable[]
  emailDeliveries     ProposalEmail[]
  providerJobs        ProviderJob[]
}

// Integração de envio corporativo. Os tokens são sempre persistidos
// criptografados pela aplicação; nunca ficam disponíveis para o navegador.
model EmailIntegration {
  id                    String          @id @default(uuid())
  provider              String          @unique // GMAIL
  email                 String
  displayName           String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  scope                 String
  tokenType             String          @default("Bearer")
  active                Boolean         @default(true)
  lastError             String?
  connectedById         String
  connectedBy           User            @relation("EmailIntegrationConnector", fields: [connectedById], references: [id])
  deliveries            ProposalEmail[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([active, updatedAt])
}

model ProposalEmail {
  id               String            @id @default(uuid())
  quoteId          String
  quote            Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  integrationId    String?
  integration      EmailIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  senderEmail      String
  recipientEmail   String
  ccEmails         String?
  subject          String
  body             String
  attachmentName   String?
  attachmentSha256 String?
  status           String            @default("PREPARANDO") // PREPARANDO, ENVIANDO, ENVIADO, FALHA
  gmailMessageId   String?
  gmailThreadId    String?
  errorMessage     String?
  sentById         String
  sentBy           User              @relation("ProposalEmailSender", fields: [sentById], references: [id])
  sentAt           DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([quoteId, createdAt])
  @@index([status, createdAt])
  @@index([sentById, createdAt])
}

model QuoteItem {
  id               String       @id @default(uuid())
  quoteId          String
  quote            Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  type             String // SERVICO, TERCEIRIZADO, PRODUTO, PECAS, MAO_DE_OBRA, DESLOCAMENTO, IMPOSTO
  description      String
  quantity         Float        @default(1)
  unit             String       @default("UN") // UN, HR, KM
  unitPrice        Decimal      @default(0.0) @db.Decimal(10, 2)
  costPrice        Decimal      @default(0.0) @db.Decimal(10, 2)
  markupPercentage Decimal      @default(0.0) @db.Decimal(7, 2)
  discount         Decimal      @default(0.0) @db.Decimal(10, 2)
  total            Decimal      @default(0.0) @db.Decimal(10, 2)
  supplierId       String?
  supplier         Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  providerJob      ProviderJob?
}

model QuoteVersion {
  id          String   @id @default(uuid())
  quoteId     String
  version     Int
  total       Decimal  @db.Decimal(10, 2)
  status      String
  changesJson String
  createdAt   DateTime @default(now())
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model QuoteApproval {
  id            String   @id @default(uuid())
  quoteId       String
  quote         Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  approved      Boolean
  justification String?
  userId        String
  createdAt     DateTime @default(now())
}

// 5. Operacional & Ordem de Serviço (OS)
model ServiceOrder {
  id                  String                      @id @default(uuid())
  code                String                      @unique // OS-2026-0001
  quoteId             String?
  quote               Quote?                      @relation(fields: [quoteId], references: [id])
  clientId            String
  client              Client                      @relation(fields: [clientId], references: [id])
  addressId           String?
  address             ClientAddress?              @relation(fields: [addressId], references: [id])
  contactId           String?
  contact             ClientContact?              @relation(fields: [contactId], references: [id])
  status              String                      @default("CRIADA") // CRIADA, AGUARDANDO_AGENDAMENTO, AGENDADA, DESLOCAMENTO, EXECUCAO, PAUSADA, AGUARDANDO_PECA, AGUARDANDO_CLIENTE, RETORNO, CONCLUIDA, REVISAO, RELATORIO_ENVIADO, FATURAMENTO, FATURADA, CANCELADA
  priority            String                      @default("MEDIA") // BAIXA, MEDIA, ALTA, URGENTE
  type                String // INSTALACAO, PREVENTIVA, CORRETIVA, CONTRATO, VISITA_TECNICA, GARANTIA, RETORNO, EMERGENCIA, LAUDO_TECNICO, ORCAMENTO_TECNICO
  serviceCategory     String                      @default("GERAL") // CLIMATIZACAO, ELETRICA, ILUMINACAO, HIDRAULICA, CIVIL, REFRIGERACAO, GERAL
  scheduledDate       DateTime?
  scheduledTime       String?
  problemReported     String?
  technicalDiagnosis  String?
  checklistJson       String                      @default("[]") // Saved checklist answers
  signatureBase64     String? // Client signature
  signatureName       String? // Person who signed
  marginReal          Float                       @default(0.0)
  faturamentoStatus   String                      @default("AGUARDANDO_FATURAMENTO") // AGUARDANDO_FATURAMENTO, CONFERENCIA, EMISSAO_NF, NF_EMITIDA, NF_ENVIADA
  invoiceId           String?
  notes               String?
  purchaseOrder       String?
  billingMirrorJson   Json?
  storeProjectId      String?
  storeProject        ClientStoreProject?         @relation(fields: [storeProjectId], references: [id], onDelete: SetNull)
  storeAssetId        String?
  storeAsset          StoreAsset?                 @relation(fields: [storeAssetId], references: [id], onDelete: SetNull)
  requestSource       String                      @default("INTERNO")
  operationKind       String                      @default("AVULSA") // AVULSA, VISITA_PREVENTIVA, CHAMADO_CONTRATO
  referenceMonth      String? // Competência operacional no formato YYYY-MM
  requesterName       String?
  requesterEmail      String?
  requesterPhone      String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  completedAt         DateTime?
  items               ServiceOrderItem[]
  materials           ServiceOrderMaterial[]
  photos              ServiceOrderPhoto[]
  statusHistory       ServiceOrderStatusHistory[]
  technicians         ServiceOrderTechnician[]
  visits              ServiceVisit[]
  serviceOrderAssets  ServiceOrderAsset[]
  evidences           Evidence[]
  measurementReadings MeasurementReading[]
  completionReport    CompletionReport?
  invoices            Invoice[]
  nfseRecords         NfseRecord[]
  accountsReceivable  AccountsReceivable[]
  accountsPayable     AccountsPayable[]
  stockMovements      StockMovement[]
  contractId          String?
  contract            Contract?                   @relation(fields: [contractId], references: [id])
  formSubmissions     FormSubmission[]
  providerJobs        ProviderJob[]

  @@index([storeProjectId])
  @@index([storeAssetId])
  @@index([contractId, referenceMonth])
  @@index([operationKind, referenceMonth])
}

model ServiceOrderItem {
  id             String       @id @default(uuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  description    String
  quantity       Float        @default(1)
  unit           String       @default("UN")
  unitPrice      Decimal      @default(0.0) @db.Decimal(10, 2)
  total          Decimal      @default(0.0) @db.Decimal(10, 2)
}

model ServiceOrderMaterial {
  id              String       @id @default(uuid())
  serviceOrderId  String
  serviceOrder    ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product      @relation(fields: [productId], references: [id])
  quantity        Float        @default(1)
  costPrice       Decimal      @default(0.0) @db.Decimal(10, 2)
  salePrice       Decimal      @default(0.0) @db.Decimal(10, 2)
  usedQuantity    Float        @default(0) // actual quantity used
  status          String       @default("PREVISTO") // PREVISTO, UTILIZADO, DEVOLVIDO
  acquisitionType String       @default("ESTOQUE") // ESTOQUE, COMPRA_FUTURA
}

model ServiceOrderPhoto {
  id             String       @id @default(uuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  step           String // ANTES, DEPOIS, EVIDENCIA
  url            String // Image url or base64 data
  caption        String?
  uploadedAt     DateTime     @default(now())
}

model ServiceOrderStatusHistory {
  id             String       @id @default(uuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  oldStatus      String
  newStatus      String
  changedById    String
  changedBy      User         @relation(fields: [changedById], references: [id])
  justification  String?
  changedAt      DateTime     @default(now())
}

model ServiceOrderTechnician {
  id             String       @id @default(uuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
}

// Uma OS representa o processo completo. Cada deslocamento/atendimento em
// campo é uma visita independente, preservando equipe, agenda, tempos e
// resultado mesmo quando existe retorno ao cliente.
model ServiceVisit {
  id                       String               @id @default(uuid())
  serviceOrderId           String
  serviceOrder             ServiceOrder         @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  number                   Int
  kind                     String               @default("ATENDIMENTO") // ATENDIMENTO, DIAGNOSTICO, RETORNO, VISTORIA
  status                   String               @default("NAO_AGENDADA") // NAO_AGENDADA, AGENDADA, ACEITA, EM_DESLOCAMENTO, NO_LOCAL, EM_EXECUCAO, PAUSADA, IMPEDIDA, CONCLUIDA, CANCELADA
  scheduledStart           DateTime?
  scheduledEnd             DateTime?
  windowStart              DateTime?
  windowEnd                DateTime?
  estimatedDurationMinutes Int                  @default(60)
  acceptedAt               DateTime?
  travelStartedAt          DateTime?
  arrivedAt                DateTime?
  startedAt                DateTime?
  pausedAt                 DateTime?
  completedAt              DateTime?
  cancelledAt              DateTime?
  result                   String? // RESOLVIDO, RETORNO_NECESSARIO, IMPEDIMENTO, SEM_ACESSO
  returnReason             String?
  notes                    String?
  checkinLatitude          Float?
  checkinLongitude         Float?
  checkoutLatitude         Float?
  checkoutLongitude        Float?
  sourceVisitId            String?
  sourceVisit              ServiceVisit?        @relation("VisitReturnChain", fields: [sourceVisitId], references: [id], onDelete: SetNull)
  returnVisits             ServiceVisit[]       @relation("VisitReturnChain")
  technicians              VisitTechnician[]
  statusHistory            VisitStatusHistory[]
  timeEntries              TimeEntry[]
  locationEvents           LocationEvent[]
  evidences                Evidence[]
  measurementReadings      MeasurementReading[]
  formSubmissions          FormSubmission[]
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@unique([serviceOrderId, number])
  @@index([status, scheduledStart])
  @@index([sourceVisitId])
}

model VisitTechnician {
  id         String       @id @default(uuid())
  visitId    String
  visit      ServiceVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String       @default("TECNICO") // RESPONSAVEL, TECNICO, AUXILIAR
  acceptedAt DateTime?
  createdAt  DateTime     @default(now())

  @@unique([visitId, userId])
  @@index([userId, createdAt])
}

model VisitStatusHistory {
  id            String       @id @default(uuid())
  visitId       String
  visit         ServiceVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  oldStatus     String
  newStatus     String
  changedById   String?
  changedBy     User?        @relation(fields: [changedById], references: [id], onDelete: SetNull)
  justification String?
  latitude      Float?
  longitude     Float?
  changedAt     DateTime     @default(now())

  @@index([visitId, changedAt])
}

model TimeEntry {
  id          String       @id @default(uuid())
  visitId     String
  visit       ServiceVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // DESLOCAMENTO, EXECUCAO, PAUSA
  startedAt   DateTime
  endedAt     DateTime?
  durationMin Int?
  notes       String?
  createdAt   DateTime     @default(now())

  @@index([visitId, startedAt])
  @@index([userId, startedAt])
}

model LocationEvent {
  id        String       @id @default(uuid())
  visitId   String
  visit     ServiceVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // DESLOCAMENTO_INICIADO, CHECKIN, CHECKOUT, POSICAO
  latitude  Float
  longitude Float
  accuracy  Float?
  createdAt DateTime     @default(now())

  @@index([visitId, createdAt])
}

// Liga uma OS a todos os ativos envolvidos. Durante a convergência, aceita
// tanto o cadastro simples legado quanto o patrimônio técnico da loja.
model ServiceOrderAsset {
  id                String           @id @default(uuid())
  serviceOrderId    String
  serviceOrder      ServiceOrder     @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  storeAssetId      String?
  storeAsset        StoreAsset?      @relation(fields: [storeAssetId], references: [id], onDelete: SetNull)
  clientEquipmentId String?
  clientEquipment   ClientEquipment? @relation(fields: [clientEquipmentId], references: [id], onDelete: SetNull)
  isPrimary         Boolean          @default(false)
  problem           String?
  createdAt         DateTime         @default(now())

  @@unique([serviceOrderId, storeAssetId])
  @@unique([serviceOrderId, clientEquipmentId])
  @@index([storeAssetId])
  @@index([clientEquipmentId])
}

model Evidence {
  id                String           @id @default(uuid())
  serviceOrderId    String
  serviceOrder      ServiceOrder     @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  visitId           String?
  visit             ServiceVisit?    @relation(fields: [visitId], references: [id], onDelete: SetNull)
  storeAssetId      String?
  storeAsset        StoreAsset?      @relation(fields: [storeAssetId], references: [id], onDelete: SetNull)
  clientEquipmentId String?
  clientEquipment   ClientEquipment? @relation(fields: [clientEquipmentId], references: [id], onDelete: SetNull)
  authorId          String?
  author            User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  kind              String           @default("FOTO") // FOTO, ASSINATURA, DOCUMENTO, AUDIO
  stage             String? // ANTES, DURANTE, DEPOIS, CHECKLIST, DIAGNOSTICO
  fileUrl           String
  fileName          String?
  mimeType          String?
  sizeBytes         Int?
  sha256            String?
  caption           String?
  latitude          Float?
  longitude         Float?
  capturedAt        DateTime?
  createdAt         DateTime         @default(now())

  @@index([serviceOrderId, createdAt])
  @@index([visitId, createdAt])
  @@index([storeAssetId])
  @@index([clientEquipmentId])
}

model MeasurementDefinition {
  id        String               @id @default(uuid())
  code      String               @unique
  name      String
  category  String
  unit      String
  minValue  Float?
  maxValue  Float?
  decimals  Int                  @default(2)
  active    Boolean              @default(true)
  readings  MeasurementReading[]
  questions FormQuestion[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

// Formulários de campo são versionados para que mudanças futuras não alterem
// o conteúdo nem a auditoria de visitas já executadas.
model FormTemplate {
  id            String        @id @default(uuid())
  code          String        @unique
  name          String
  description   String?
  category      String        @default("GERAL") // HVAC, ELETRICA, CIVIL, HIDRAULICA, GERAL
  serviceType   String?
  assetCategory String?
  active        Boolean       @default(true)
  versions      FormVersion[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model FormVersion {
  id          String           @id @default(uuid())
  templateId  String
  template    FormTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     Int
  status      String           @default("RASCUNHO") // RASCUNHO, PUBLICADO, ARQUIVADO
  publishedAt DateTime?
  sections    FormSection[]
  submissions FormSubmission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([templateId, version])
  @@index([status, publishedAt])
}

model FormSection {
  id          String         @id @default(uuid())
  versionId   String
  version     FormVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  title       String
  description String?
  position    Int            @default(0)
  questions   FormQuestion[]

  @@index([versionId, position])
}

model FormQuestion {
  id                      String                 @id @default(uuid())
  sectionId               String
  section                 FormSection            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  code                    String
  label                   String
  helpText                String?
  type                    String                 @default("CHECKBOX") // CHECKBOX, TEXT, LONG_TEXT, NUMBER, SELECT, MEASUREMENT
  required                Boolean                @default(false)
  position                Int                    @default(0)
  optionsJson             String                 @default("[]")
  measurementDefinitionId String?
  measurementDefinition   MeasurementDefinition? @relation(fields: [measurementDefinitionId], references: [id], onDelete: SetNull)
  answers                 FormAnswer[]

  @@unique([sectionId, code])
  @@index([sectionId, position])
  @@index([measurementDefinitionId])
}

model FormSubmission {
  id             String       @id @default(uuid())
  versionId      String
  version        FormVersion  @relation(fields: [versionId], references: [id])
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  visitId        String
  visit          ServiceVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  submittedById  String?
  submittedBy    User?        @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  status         String       @default("RASCUNHO") // RASCUNHO, ENVIADO
  startedAt      DateTime     @default(now())
  submittedAt    DateTime?
  answers        FormAnswer[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([visitId, versionId])
  @@index([serviceOrderId, status])
  @@index([submittedById, updatedAt])
}

model FormAnswer {
  id            String         @id @default(uuid())
  submissionId  String
  submission    FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId    String
  question      FormQuestion   @relation(fields: [questionId], references: [id])
  valueText     String?
  valueNumber   Float?
  valueBoolean  Boolean?
  valueJson     String?
  notApplicable Boolean        @default(false)
  answeredAt    DateTime       @default(now())

  @@unique([submissionId, questionId])
  @@index([questionId])
}

model MeasurementReading {
  id                String                @id @default(uuid())
  definitionId      String
  definition        MeasurementDefinition @relation(fields: [definitionId], references: [id])
  serviceOrderId    String
  serviceOrder      ServiceOrder          @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  visitId           String?
  visit             ServiceVisit?         @relation(fields: [visitId], references: [id], onDelete: SetNull)
  storeAssetId      String?
  storeAsset        StoreAsset?           @relation(fields: [storeAssetId], references: [id], onDelete: SetNull)
  clientEquipmentId String?
  clientEquipment   ClientEquipment?      @relation(fields: [clientEquipmentId], references: [id], onDelete: SetNull)
  recordedById      String?
  recordedBy        User?                 @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  value             Float
  rawValue          String?
  status            String                @default("NORMAL") // NORMAL, ABAIXO, ACIMA, INVALIDO
  recordedAt        DateTime              @default(now())

  @@index([serviceOrderId, recordedAt])
  @@index([visitId, recordedAt])
  @@index([storeAssetId, recordedAt])
  @@index([clientEquipmentId, recordedAt])
}

model SequenceCounter {
  key       String   @id
  value     Int
  updatedAt DateTime @updatedAt
}

model CompletionReport {
  id                    String       @id @default(uuid())
  serviceOrderId        String       @unique
  serviceOrder          ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  executedServices      String?
  clientFeedback        String?
  technicalObservations String?
  pendingActions        String?
  operationalResult     String       @default("OPERACIONAL")
  clientRepresentative  String?
  warrantyTerms         String?      @default("Garantia de 90 dias nos serviços prestados.")
  approvedByClient      Boolean      @default(false)
  approvedAt            DateTime?
  createdAt             DateTime     @default(now())
}

// 6. Faturamento e Nota Fiscal (Invoices)
model Invoice {
  id             String               @id @default(uuid())
  code           String               @unique // NF-000123
  serviceOrderId String?
  serviceOrder   ServiceOrder?        @relation(fields: [serviceOrderId], references: [id])
  clientId       String
  client         Client               @relation(fields: [clientId], references: [id])
  issueDate      DateTime             @default(now())
  value          Float
  taxValue       Float                @default(0.0)
  status         String               @default("EMITIDA") // EMITIDA, ENVIADA, CANCELADA, SUBSTITUIDA
  pdfUrl         String?
  xmlUrl         String?
  paymentTerms   String?
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  receivables    AccountsReceivable[]
}

// 7. Financeiro (Accounts Receivable/Payable, Transactions)
model AccountsReceivable {
  id             String                 @id @default(uuid())
  clientId       String
  client         Client                 @relation(fields: [clientId], references: [id])
  serviceOrderId String?
  serviceOrder   ServiceOrder?          @relation(fields: [serviceOrderId], references: [id])
  quoteId        String?
  quote          Quote?                 @relation(fields: [quoteId], references: [id])
  invoiceId      String?
  invoice        Invoice?               @relation(fields: [invoiceId], references: [id])
  totalValue     Decimal                @db.Decimal(10, 2)
  receivedValue  Decimal                @default(0.0) @db.Decimal(10, 2)
  pendingValue   Decimal                @db.Decimal(10, 2)
  issueDate      DateTime               @default(now())
  dueDate        DateTime
  paymentDate    DateTime?
  paymentMethod  String? // PIX, BOLETO, CARTAO, DINHEIRO, TRANSFERENCIA
  status         String                 @default("ABERTO") // ABERTO, VENCIDO, PARCIAL, PAGO, CANCELADO, ESTORNADO
  bankAccountId  String?
  bankAccount    BankAccount?           @relation(fields: [bankAccountId], references: [id])
  category       String                 @default("RECEITA_SERVICO") // RECEITA_SERVICO, VENDA_PECA, CONTRATO, OUTROS
  costCenter     String                 @default("GERAL")
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  transactions   FinancialTransaction[]
}

model AccountsPayable {
  id             String                 @id @default(uuid())
  providerName   String // Fornecedor
  serviceOrderId String?
  serviceOrder   ServiceOrder?          @relation(fields: [serviceOrderId], references: [id])
  description    String
  category       String // PECA, COMBUSTIVEL, ALUGUEL, FERRAMENTAS, IMPOSTOS, FOLHA, MARKETING, OUTROS
  costCenter     String                 @default("GERAL")
  value          Decimal                @db.Decimal(10, 2)
  dueDate        DateTime
  paymentDate    DateTime?
  paymentMethod  String?
  status         String                 @default("ABERTO") // ABERTO, VENCIDO, PAGO, CANCELADO, ESTORNADO
  receiptUrl     String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  transactions   FinancialTransaction[]
  providerJob    ProviderJob?
}

model FinancialTransaction {
  id                   String              @id @default(uuid())
  type                 String // RECEITA, DESPESA
  value                Decimal             @db.Decimal(10, 2)
  date                 DateTime            @default(now())
  category             String
  costCenter           String              @default("GERAL")
  accountsReceivableId String?
  accountsReceivable   AccountsReceivable? @relation(fields: [accountsReceivableId], references: [id])
  accountsPayableId    String?
  accountsPayable      AccountsPayable?    @relation(fields: [accountsPayableId], references: [id])
  description          String
  bankAccountId        String?
  bankAccount          BankAccount?        @relation(fields: [bankAccountId], references: [id])
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model BankAccount {
  id              String                 @id @default(uuid())
  name            String                 @unique // Caixa Geral, Banco do Brasil, Itaú
  bank            String
  agency          String
  accountNumber   String
  balance         Decimal                @default(0.0) @db.Decimal(10, 2)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  receivables     AccountsReceivable[]
  transactions    FinancialTransaction[]
  reconciliations BankReconciliation[]
}

model BankReconciliation {
  id            String      @id @default(uuid())
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  date          DateTime
  bankBalance   Float
  systemBalance Float
  status        String      @default("PENDENTE") // PENDENTE, CONCILIADO
  createdAt     DateTime    @default(now())
}

// Catálogos oficiais de referência para orçamentos e licitações.
// Mantidos separados do estoque/serviços internos para preservar a origem,
// competência e metodologia de cada composição.
model ReferencePriceItem {
  id                 String   @id @default(uuid())
  base               String   // SINAPI, SICRO, SEINFRA, OUTRA
  sourceOrganization String?
  state              String?
  referenceMonth     String?
  regime             String?
  itemType           String   // COMPOSICAO, INSUMO, MANUAL
  code               String
  description        String
  unit               String?
  unitPrice          Decimal  @db.Decimal(14, 4)
  metadataJson       String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([base, referenceMonth, code, state, regime])
  @@index([base, referenceMonth])
  @@index([code])
  @@index([description])
}

model ConstructionBudget {
  id              String   @id @default(uuid())
  code            String
  version         Int      @default(1)
  workName        String
  clientId        String?
  contractorName  String?
  technicalLead   String?
  address         String?
  status          String   @default("RASCUNHO")
  isPublic        Boolean  @default(false)
  procurementJson String?  @db.Text
  enabledBasesJson String? @db.Text
  directCost      Decimal  @default(0) @db.Decimal(14, 2)
  bdiPercentage   Decimal  @default(0) @db.Decimal(8, 4)
  bdiValue        Decimal  @default(0) @db.Decimal(14, 2)
  globalTotal     Decimal  @default(0) @db.Decimal(14, 2)
  frozenAt        DateTime?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           ConstructionBudgetItem[]
  bdi             ConstructionBdi?
  periods         ConstructionSchedulePeriod[]
  @@unique([code, version])
  @@index([status, createdAt])
}

model ConstructionBudgetItem {
  id                  String   @id @default(uuid())
  budgetId            String
  budget              ConstructionBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  parentId            String?
  parent              ConstructionBudgetItem? @relation("BudgetItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children             ConstructionBudgetItem[] @relation("BudgetItemTree")
  kind                String   // ETAPA, SUBETAPA, SERVICO
  hierarchyCode       String
  sortOrder           Int      @default(0)
  description         String
  sourceBase          String?
  sourceCode          String?
  sourceItemId        String?
  unit                String?
  calculationMemory   String?
  quantity            Decimal  @default(0) @db.Decimal(14, 4)
  referenceUnitPrice  Decimal  @default(0) @db.Decimal(14, 4)
  adoptedUnitPrice    Decimal  @default(0) @db.Decimal(14, 4)
  adjustmentPercent   Decimal  @default(0) @db.Decimal(8, 4)
  directTotal         Decimal  @default(0) @db.Decimal(14, 2)
  differentiatedBdi   Decimal?
  bdiValue            Decimal  @default(0) @db.Decimal(14, 2)
  totalWithBdi        Decimal  @default(0) @db.Decimal(14, 2)
  snapshotJson        String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  @@unique([budgetId, hierarchyCode])
  @@index([budgetId, parentId, sortOrder])
  @@index([sourceBase, sourceCode])
}

model ConstructionBdi {
  id                   String   @id @default(uuid())
  budgetId             String   @unique
  budget               ConstructionBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  administration       Decimal  @default(0) @db.Decimal(8, 4)
  financial            Decimal  @default(0) @db.Decimal(8, 4)
  risk                 Decimal  @default(0) @db.Decimal(8, 4)
  insuranceGuarantee   Decimal  @default(0) @db.Decimal(8, 4)
  profit               Decimal  @default(0) @db.Decimal(8, 4)
  cofins              Decimal  @default(0) @db.Decimal(8, 4)
  pis                 Decimal  @default(0) @db.Decimal(8, 4)
  cprb                Decimal  @default(0) @db.Decimal(8, 4)
  iss                 Decimal  @default(0) @db.Decimal(8, 4)
  directPercentage    Decimal?
  minReference        Decimal?
  maxReference        Decimal?
  memoryJson          String?  @db.Text
  updatedAt           DateTime @updatedAt
}

model ConstructionSchedulePeriod {
  id         String   @id @default(uuid())
  budgetId   String
  budget     ConstructionBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  period     Int
  startDate  DateTime?
  endDate    DateTime?
  allocationsJson String @db.Text
  percentage Decimal  @default(0) @db.Decimal(8, 4)
  amount     Decimal  @default(0) @db.Decimal(14, 2)
  @@unique([budgetId, period])
}

// 8. Produtos, Estoque e Serviços
model Product {
  id            String                 @id @default(uuid())
  code          String                 @unique // P-0001
  name          String
  description   String?
  type          String                 @default("PECA") // PECA, MATERIAL, EQUIPAMENTO
  costPrice     Decimal                @default(0.0) @db.Decimal(10, 2)
  salePrice     Decimal                @default(0.0) @db.Decimal(10, 2)
  stockQuantity Float                  @default(0)
  minStock      Float                  @default(0)
  unit          String                 @default("UN")
  supplierId    String?
  supplier      Supplier?              @relation(fields: [supplierId], references: [id])
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  materials     ServiceOrderMaterial[]
  movements     StockMovement[]
}

model StockMovement {
  id             String        @id @default(uuid())
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  type           String // ENTRADA, SAIDA
  quantity       Float
  reason         String // COMPRA, AJUSTE, OS_UTILIZADO, OS_DEVOLVIDO, PERDA
  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id])
  date           DateTime      @default(now())
  cost           Float         @default(0.0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Service {
  id                      String    @id @default(uuid())
  name                    String    @unique
  description             String?
  category                String?
  maintenanceType         String?
  billingUnit             String?   @default("Serviço")
  estimatedHours          Float?
  defaultPrice            Float     @default(0.0)
  serviceType             String    @default("PROPRIO") // PROPRIO, TERCEIRIZADO
  workforceRegime         String    @default("CLT") // CLT, PROFISSIONAL, AUTONOMO, TERCEIRIZADO
  referenceCode           String?
  materialCost            Float     @default(0.0)
  laborCost               Float     @default(0.0)
  equipmentCost           Float     @default(0.0)
  otherDirectCost         Float     @default(0.0)
  productivity            Float     @default(1.0)
  payrollBurdenPercentage Float     @default(0.0)
  overheadPercentage      Float     @default(0.0)
  riskPercentage          Float     @default(0.0)
  profitPercentage        Float     @default(0.0)
  serviceTaxPercentage    Float     @default(0.0)
  supplierId              String?
  supplier                Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([serviceType])
  @@index([supplierId])
}

model Supplier {
  id              String        @id @default(uuid())
  name            String
  cnpj            String        @unique
  phone           String
  email           String
  portalEmail     String?       @unique
  portalPassword  String?
  portalSalt      String?
  portalActive    Boolean       @default(false)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  products        Product[]
  quoteItems      QuoteItem[]
  providerJobs    ProviderJob[]
  catalogServices Service[]
}

// Execucao e custo de servicos realizados por parceiros. Estes dados sao
// internos e nunca fazem parte do documento comercial enviado ao cliente.
model ProviderJob {
  id                String           @id @default(uuid())
  supplierId        String
  supplier          Supplier         @relation(fields: [supplierId], references: [id])
  quoteId           String
  quote             Quote            @relation(fields: [quoteId], references: [id])
  quoteItemId       String           @unique
  quoteItem         QuoteItem        @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)
  serviceOrderId    String
  serviceOrder      ServiceOrder     @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  accountsPayableId String?          @unique
  accountsPayable   AccountsPayable? @relation(fields: [accountsPayableId], references: [id], onDelete: SetNull)
  description       String
  quantity          Float            @default(1)
  unit              String           @default("SERVIÇO")
  costValue         Decimal          @db.Decimal(10, 2)
  saleValue         Decimal          @db.Decimal(10, 2)
  executionStatus   String           @default("PENDENTE") // PENDENTE, AGENDADO, EXECUCAO, CONCLUIDO, CANCELADO
  paymentStatus     String           @default("BLOQUEADO") // BLOQUEADO, LIBERADO, PAGO, CANCELADO
  scheduledDate     DateTime?
  completedAt       DateTime?
  paymentDueDate    DateTime?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([supplierId, executionStatus])
  @@index([serviceOrderId])
  @@index([paymentStatus, paymentDueDate])
}

// 9. Contratos Recorrentes
model Contract {
  id            String               @id @default(uuid())
  clientId      String
  client        Client               @relation(fields: [clientId], references: [id])
  addressId     String?
  address       ClientAddress?       @relation(fields: [addressId], references: [id], onDelete: SetNull)
  contactId     String?
  contact       ClientContact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  code          String               @unique // C-2026-0001
  value         Decimal              @db.Decimal(10, 2)
  billingPeriod String               @default("MENSAL") // MENSAL, TRIMESTRAL, ANUAL
  startDate     DateTime
  endDate       DateTime
  status        String               @default("ATIVO") // ATIVO, SUSPENSO, CANCELADO, VENCIDO
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  items         ContractItem[]
  serviceOrders ServiceOrder[]
  storeProjects ClientStoreProject[]
  portal        StorePortal?

  @@index([addressId])
  @@index([contactId])
}

model StorePortal {
  id                  String    @id @default(uuid())
  contractId          String    @unique
  contract            Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  token               String    @unique @default(uuid())
  enabled             Boolean   @default(true)
  allowTicketCreation Boolean   @default(true)
  lastAccessAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model ContractItem {
  id          String   @id @default(uuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  description String
  quantity    Float    @default(1)
  unitPrice   Decimal  @default(0.0) @db.Decimal(10, 2)
}

// 10. Utilitários Gerais (Notificações, Auditoria, Logs)
model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String // COMERCIAL, OPERACIONAL, FINANCEIRO, ESTOQUE
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model MarketingPost {
  id           String   @id @default(uuid())
  title        String
  caption      String?
  publishDate  String
  publishTime  String
  status       String   @default("IDEIA")
  channelsJson String   @default("[]")
  format       String
  owner        String
  campaign     String
  createdById  String?
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([publishDate, status])
  @@index([owner])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  action       String // CRIACAO, EDICAO, EXCLUSAO, APROVACAO, CANCELAMENTO
  entity       String // Cliente, Orcamento, OS, ContaReceber, etc.
  entityId     String
  changesJson  String // JSON format string of values changed
  category     String   @default("GENERAL")
  previousJson String?
  newJson      String?
  ipAddress    String?
  userAgent    String?
  timestamp    DateTime @default(now())
}

model Attachment {
  id         String   @id @default(uuid())
  name       String
  url        String
  sizeBytes  Int
  mimeType   String
  entityType String // OS, Orcamento, Cliente, etc.
  entityId   String
  createdAt  DateTime @default(now())
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique // company.name, company.cnpj, etc.
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ErrorReport {
  id              String   @id @default(uuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  status          String   @default("ABERTO")
  severity        String   @default("ERRO")
  description     String
  pageUrl         String
  userAgent       String?
  errorMessage    String?
  errorStack      String?
  consoleLogsJson String   @default("[]")
  screenshotData  String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model SecurityThrottle {
  key          String    @id
  attempts     Int       @default(0)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
}

// Importações são registradas em duas camadas: o lote resume a operação e
// cada linha preserva a origem, a normalização e o vínculo criado/atualizado.
// Isso permite reprocessar, auditar e corrigir uma planilha sem perder dados.
model ImportBatch {
  id          String      @id @default(uuid())
  type        String
  fileName    String?
  status      String      @default("PROCESSANDO") // PROCESSANDO, CONCLUIDO, CONCLUIDO_COM_ERROS, FALHOU
  totalRows   Int         @default(0)
  createdRows Int         @default(0)
  updatedRows Int         @default(0)
  skippedRows Int         @default(0)
  errorRows   Int         @default(0)
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  finishedAt  DateTime?
  rows        ImportRow[]

  @@index([type, createdAt])
  @@index([status, createdAt])
}

model ImportRow {
  id             String      @id @default(uuid())
  batchId        String
  batch          ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber      Int
  status         String // CRIADO, ATUALIZADO, IGNORADO, ERRO
  entityType     String
  entityId       String?
  sourceJson     String
  normalizedJson String?
  error          String?
  createdAt      DateTime    @default(now())

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@index([entityType, entityId])
}

// 8. Módulo Fiscal NFS-e Duque de Caxias / Padrão Nacional v1.01
model NfseRecord {
  id                       String        @id @default(uuid())
  tenantId                 String        @default("00000000-0000-4000-8000-000000000001")
  serviceOrderId           String?
  serviceOrder             ServiceOrder? @relation(fields: [serviceOrderId], references: [id])
  clientId                 String
  client                   Client        @relation(fields: [clientId], references: [id])
  environment              String        @default("homologation") // homologation, production
  dpsSeries                String        @default("1")
  dpsNumber                Int
  dpsCompetence            DateTime      @default(now())
  status                   String        @default("RASCUNHO") // RASCUNHO, AGUARDANDO_CONFIRMACAO, VALIDANDO, ENVIANDO, RESULTADO_INCERTO, AUTORIZADA, REJEITADA, ERRO_COMUNICACAO, CANCELAMENTO_PENDENTE, CANCELADA
  serviceValue             Decimal       @db.Decimal(12, 2)
  cTribNac                 String
  cTribMun                 String?
  cNBS                     String?
  accessKey                String? // Chave de Acesso da NFS-e Nacional de 50 dígitos
  nfseNumber               String? // Número da NFS-e autorizada
  requestXml               String?       @db.Text
  responseXml              String?       @db.Text
  authorizedXml            String?       @db.Text
  visualizationUrl         String?       @db.Text
  nationalVisualizationUrl String?       @db.Text
  errorCode                String?
  errorMessage             String?       @db.Text
  createdBy                String?
  confirmedBy              String?
  sentAt                   DateTime?
  authorizedAt             DateTime?
  cancelledAt              DateTime?
  cancelReasonCode         String?
  cancelReasonDesc         String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@index([dpsSeries, dpsNumber])
  @@index([serviceOrderId])
  @@index([clientId])
  @@index([status])
}

model DpsSequence {
  series       String   @id
  tenantId     String   @db.Uuid
  fiscalSeries String
  lastNumber   Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, fiscalSeries])
}
