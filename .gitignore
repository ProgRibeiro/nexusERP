# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local databases
*.db
*.db-journal

# backup files
/prisma_sqlite_backup/
/backups/

# uploaded files (fotos de OS, assinaturas) — persistidos no disco do servidor, não versionados
/public/uploads/*
!/public/uploads/.gitkeep

# local development/diagnostic artifacts
/.claude/
/tmp/
/src/tests/test_output.log

# allow example envs
!.env.example
