# === Banco de Dados ===
# Desenvolvimento local com PostgreSQL instalado no sistema (porta padrão 5432):
DATABASE_URL="postgresql://seu_usuario@localhost:5432/erp_prestacao_servicos?schema=public"
TENANT_ID="00000000-0000-4000-8000-000000000001"

# No Linux/Cloudex, use um usuário exclusivo e senha forte:
# DATABASE_URL="postgresql://nexus_erp:SENHA_FORTE@127.0.0.1:5432/nexus_erp?schema=public"

# === Sessão/Autenticação ===
# String aleatória com pelo menos 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA reutilize o valor de exemplo abaixo em produção.
SESSION_SECRET="troque-por-uma-string-aleatoria-de-32-ou-mais-caracteres"

# Chave exclusiva para criptografar tokens das integrações (Gmail etc.).
# Gere com o mesmo comando acima e use um valor diferente de SESSION_SECRET.
INTEGRATION_ENCRYPTION_KEY="troque-por-outra-string-aleatoria-de-32-ou-mais-caracteres"

# Endereço público/base do ERP. Para uso apenas nesta máquina, localhost funciona.
# No servidor Linux acessível pela rede, use o domínio HTTPS configurado.
APP_BASE_URL="http://localhost:3000"

# === Envio de propostas pelo Gmail (OAuth 2.0) ===
# Crie um cliente OAuth do tipo "Aplicativo da Web" no Google Cloud e cadastre:
# http://localhost:3000/api/integrations/gmail/callback
GOOGLE_GMAIL_CLIENT_ID=""
GOOGLE_GMAIL_CLIENT_SECRET=""

# Habilita o seletor de "trocar de perfil" (impersonation) usado para QA/demo
# de permissões. Mantenha "false" em qualquer ambiente com dados reais de clientes.
ALLOW_ROLE_SWITCH="true"

# === Armazenamento de fotos/assinaturas (opcional) ===
# Sem estas credenciais, o sistema usa o diretório local public/uploads.
# Para AWS S3, STORAGE_ENDPOINT pode ficar vazio. Para R2/MinIO, informe o endpoint.
STORAGE_BUCKET=""
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""
STORAGE_FORCE_PATH_STYLE="false"

# === Backups automáticos ===
# Diretório local persistente. No Linux, use /opt/nexus-erp/shared/backups.
BACKUP_DIR="./backups"
# Recomendado em produção: bucket separado para cópia externa dos backups.
BACKUP_BUCKET=""
BACKUP_PREFIX="nexus-erp"
BACKUP_REGION="us-east-1"
BACKUP_ENDPOINT=""
BACKUP_ACCESS_KEY_ID=""
BACKUP_SECRET_ACCESS_KEY=""
BACKUP_FORCE_PATH_STYLE="false"
# SLA de backup para health/auditoria (default 26h)
BACKUP_MAX_AGE_HOURS="26"
# Remove lock travado automaticamente após esse tempo (default 240 min)
BACKUP_LOCK_MAX_MINUTES="240"
