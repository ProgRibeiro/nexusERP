# === Banco de Dados ===
# Desenvolvimento local com PostgreSQL instalado no sistema (porta padrão 5432):
DATABASE_URL="postgresql://seu_usuario@localhost:5432/erp_prestacao_servicos?schema=public"
# Somente na VPS: credencial proprietária usada pelo Prisma CLI durante deploy.
# Nunca disponibilize esta variável ao processo systemd que executa o site.
MIGRATION_DATABASE_URL=""
# Somente para rotinas de backup/restore; deve pertencer a uma conta separada.
BACKUP_DATABASE_URL=""
TENANT_ID="00000000-0000-4000-8000-000000000001"

# No Linux/Cloudex, use um usuário exclusivo e senha forte:
# DATABASE_URL="postgresql://nexus_erp:SENHA_FORTE@127.0.0.1:5432/nexus_erp?schema=public"

# === Sessão/Autenticação ===
# String aleatória com pelo menos 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA reutilize o valor de exemplo abaixo em produção.
SESSION_SECRET="troque-por-uma-string-aleatoria-de-32-ou-mais-caracteres"

# Chave exclusiva para criptografar tokens das integrações (Gmail etc.).
# Gere com o mesmo comando acima e use um valor diferente de SESSION_SECRET.
INTEGRATION_ENCRYPTION_KEY="troque-por-outra-string-aleatoria-de-32-ou-mais-caracteres"

# Endereço público/base do ERP. Para uso apenas nesta máquina, localhost funciona.
# No servidor Linux acessível pela rede, use o domínio HTTPS configurado.
APP_BASE_URL="http://localhost:3000"

# === Hostnames SaaS (roteamento por subdomínio no mesmo projeto) ===
NEXUS_MARKETING_HOSTS="oprestador.tech,www.oprestador.tech"
NEXUS_APP_HOST="app.oprestador.tech"
NEXUS_COMMERCIAL_HOST="vendas.oprestador.tech"
NEXUS_DEV_HOST="dev.oprestador.tech"
NEXUS_DEVELOPER_HOST="dev.oprestador.tech"
NEXUS_MARKETING_REDIRECT_URL="https://oprestador.tech"

# URLs públicas usadas para redirecionamento pós-login
NEXT_PUBLIC_NEXUS_MARKETING_URL="https://oprestador.tech"
NEXT_PUBLIC_NEXUS_APP_URL="https://app.oprestador.tech"
NEXT_PUBLIC_NEXUS_COMMERCIAL_URL="https://vendas.oprestador.tech"
NEXT_PUBLIC_NEXUS_DEVELOPER_URL="https://dev.oprestador.tech"
# Compartilha a sessão entre site, app, vendas e dev. Não configure em localhost/IP.
SESSION_COOKIE_DOMAIN=".oprestador.tech"

# Transmissão direta de NFS-e. Mantenha false até concluir a habilitação na prefeitura.
NEXT_PUBLIC_NFSE_ISSUANCE_ENABLED="false"

# Webhook HTTPS que recebe { type, email, resetUrl, expiresInMinutes } e envia
# o e-mail de recuperação. O token nunca é registrado nos logs.
PASSWORD_RESET_WEBHOOK_URL=""

# === Envio de propostas pelo Gmail (OAuth 2.0) ===
# Crie um cliente OAuth do tipo "Aplicativo da Web" no Google Cloud e cadastre:
# http://localhost:3000/api/integrations/gmail/callback
GOOGLE_GMAIL_CLIENT_ID=""
GOOGLE_GMAIL_CLIENT_SECRET=""

# Habilita o seletor de "trocar de perfil" (impersonation) usado para QA/demo
# de permissões. Mantenha "false" em qualquer ambiente com dados reais de clientes.
ALLOW_ROLE_SWITCH="true"

# === Armazenamento de fotos/assinaturas (opcional) ===
# Sem estas credenciais, o sistema usa o diretório local public/uploads.
# Para AWS S3, STORAGE_ENDPOINT pode ficar vazio. Para R2/MinIO, informe o endpoint.
STORAGE_BUCKET=""
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""
STORAGE_FORCE_PATH_STYLE="false"

# === Backups automáticos ===
# Diretório local persistente. No Linux, use /opt/nexus-erp/shared/backups.
BACKUP_DIR="./backups"
# Recomendado em produção: bucket separado para cópia externa dos backups.
BACKUP_BUCKET=""
# Alternativa gratuita: remote criptografado do rclone, por exemplo Google Drive.
BACKUP_RCLONE_REMOTE=""
# Caminho do arquivo de configuração do rclone no servidor.
RCLONE_CONFIG=""
BACKUP_PREFIX="nexus-erp"
BACKUP_REGION="us-east-1"
BACKUP_ENDPOINT=""
BACKUP_ACCESS_KEY_ID=""
BACKUP_SECRET_ACCESS_KEY=""
BACKUP_FORCE_PATH_STYLE="false"
# Em produção, bloqueia qualquer atualização que não consiga confirmar a
# terceira camada em bucket externo (S3/R2/MinIO).
REQUIRE_OFFSITE_BACKUP="true"
# SLA de backup para health/auditoria (default 26h)
BACKUP_MAX_AGE_HOURS="26"
# Remove lock travado automaticamente após esse tempo (default 240 min)
BACKUP_LOCK_MAX_MINUTES="240"

# Alertas de backup por webhook/Discord/Slack/Telegram/WhatsApp/e-mail.
# Configure pelo menos uma destas opções para receber aviso em warning/critical.
ALERT_WEBHOOK_URL=""            # webhook genérico (também funciona para WhatsApp customizado)
ALERT_WHATSAPP_WEBHOOK_URL=""   # webhook do WhatsApp Business / conversor de webhook
ALERT_DISCORD_WEBHOOK_URL=""
ALERT_SLACK_WEBHOOK_URL=""
ALERT_TELEGRAM_BOT_TOKEN=""
ALERT_TELEGRAM_CHAT_ID=""
ALERT_EMAIL_TO=""
ALERT_EMAIL_FROM="noreply@nexus-erp.local"
ALERT_MAIL_COMMAND="mail"

# Banco temporário usado no teste automatizado de restauração.
# Se vazio, o script usa DATABASE_URL de produção para criar um banco de teste.
RESTORE_TEST_DATABASE_URL=""
