# ==============================================================================
# NEXUS ERP - EXEMPLO DE ARQUIVO DE VARIÁVEIS DE AMBIENTE (/etc/nexus-erp/nexus-erp.env)
# ==============================================================================
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=nexus_erp;Username=nexus_erp_user;Password=SUA_SENHA_GERADA_AUTOMATICAMENTE;
# Adicione outras chaves sensíveis abaixo (secrets/APIs/JWT)
# JWT__SecretKey=SUA_CHAVE_SECRETA_JWT_AQUI_MINIMO_32_CHARS
