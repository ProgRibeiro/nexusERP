NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
DATABASE_URL=postgresql://nexus_erp:SENHA_FORTE@127.0.0.1:5432/nexus_erp?schema=public
SESSION_SECRET=SEGREDO_ALEATORIO_COM_64_OU_MAIS_CARACTERES
ALLOW_ROLE_SWITCH=false
BACKUP_DIR=/opt/nexus-erp/shared/backups

# O atualizador usa /etc/nexus-erp-update.env para DEPLOY_BRANCH e DRAIN_SECONDS.
# Portas internas: blue=3001 e green=3002. Não libere essas portas no firewall.

# Armazenamento externo opcional (S3, R2 ou MinIO)
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=
STORAGE_FORCE_PATH_STYLE=false

# Segunda cópia opcional dos backups
BACKUP_BUCKET=
BACKUP_PREFIX=nexus-erp
BACKUP_REGION=us-east-1
BACKUP_ENDPOINT=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_FORCE_PATH_STYLE=false
