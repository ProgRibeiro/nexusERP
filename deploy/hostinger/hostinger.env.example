# Variaveis para deploy na Hostinger (source antes de rodar os scripts)
export APP_ROOT=/var/www/nexus-erp
export REPO_DIR=/var/www/nexus-erp/repo
export APP_DOMAIN=erp.seudominio.com.br
export APP_BASE_URL=https://erp.seudominio.com.br
export BRANCH=agent/erp-beta-linux
export KEEP_RELEASES=5
export DRAIN_SECONDS=5
